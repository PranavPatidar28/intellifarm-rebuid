# Normalize line endings to LF for all text files.
# Prevents CRLF/LF churn across Windows/macOS/Linux and keeps prettier happy.
* text=auto eol=lf

# Explicit source types (LF)
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.prisma text eol=lf
*.env  text eol=lf

# Windows-specific scripts keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary files (never normalize)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.wasm binary
*.node binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
*.pdf  binary
*.mp3  binary
*.mp4  binary
*.wav  binary
pnpm-lock.yaml -diff
