{
  "name": "@intellifarm/api",
  "version": "0.1.0",
  "description": "Shared backend API for Intellifarm web and future mobile clients",
  "author": "Codex",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/src/main.js",
    "format": "prettier --check \"{src,prisma,test}/**/*.ts\"",
    "lint": "eslint \"{src,prisma,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:deploy:prod": "prisma migrate deploy",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.67",
    "@google/genai": "^2.0.1",
    "@intellifarm/contracts": "workspace:*",
    "@nestjs/common": "^11.1.8",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.8",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/platform-express": "^11.1.8",
    "@nestjs/platform-ws": "^11.1.19",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/serve-static": "^5.0.4",
    "@nestjs/swagger": "^11.2.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.19",
    "@prisma/client": "^6.19.3",
    "aedes": "^1.0.2",
    "ai": "^6.0.174",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "express": "5.2.1",
    "helmet": "^8.2.0",
    "mqtt": "^5.15.1",
    "multer": "^2.0.2",
    "prisma": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.20.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.38.0",
    "@nestjs/cli": "^11.0.19",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.4",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.8.1",
    "@types/supertest": "^7.0.0",
    "@types/ws": "^8.18.1",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.4.0",
    "jest": "^30.0.0",
    "prettier": "^3.6.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@intellifarm/contracts$": "<rootDir>/../../../packages/contracts/dist/index.cjs"
    },
    "collectCoverageFrom": [
      "**/*.service.ts",
      "**/guards/*.ts",
      "**/utils/*.ts",
      "!**/*.spec.ts",
      "!**/generated/**"
    ],
    "coverageDirectory": "../coverage",
    "coverageThreshold": {
      "**/auth/auth.service.ts": {
        "statements": 70,
        "branches": 55,
        "functions": 60,
        "lines": 70
      },
      "**/disease-reports/disease-reports.service.ts": {
        "statements": 60,
        "branches": 45,
        "functions": 50,
        "lines": 60
      },
      "**/common/utils/cors.util.ts": {
        "statements": 80,
        "branches": 70,
        "functions": 80,
        "lines": 80
      }
    },
    "testEnvironment": "node"
  }
}
